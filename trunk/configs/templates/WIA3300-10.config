# WIA3300-10 模板配置文件（适配 MT7621A + 32MB 闪存 + 256MB 内存）
# 基础硬件配置
CONFIG_TARGET_BOARD="WIA3300-10"
CONFIG_TARGET_NAME="WIA3300-10"
CONFIG_CPU_TYPE="MT7621A"
CONFIG_FLASH_SIZE=0x2000000
CONFIG_DRAM_SIZE=0x10000000

# 网络配置
CONFIG_DEFAULT_IPADDR="192.168.2.1"
CONFIG_DEFAULT_NETMASK="255.255.255.0"
CONFIG_DEFAULT_GATEWAY="192.168.2.1"
CONFIG_DEFAULT_DNS="223.5.5.5 119.29.29.29"

# 无线配置（MT7615 双频）
CONFIG_WIFI_2G_ENABLE=y
CONFIG_WIFI_5G_ENABLE=y
CONFIG_WIFI_2G_CHANNEL="auto"
CONFIG_WIFI_5G_CHANNEL="auto"
CONFIG_WIFI_2G_POWER=20
CONFIG_WIFI_5G_POWER=18
CONFIG_WIFI_2G_SSID="WIA3300-10_2.4G"
CONFIG_WIFI_5G_SSID="WIA3300-10_5G"
CONFIG_WIFI_ENCRYPTION="WPA2-PSK"
CONFIG_WIFI_PASSWORD="1234567890"

# 系统配置
CONFIG_FIRMWARE_WEBUI_LANG="zh_cn"
CONFIG_FIRMWARE_WEBUI_THEME="default"
CONFIG_FIRMWARE_ENABLE_JFFS2=y
CONFIG_FIRMWARE_ENABLE_SSH=y
CONFIG_FIRMWARE_ENABLE_TELNET=n

# 功能模块（与工作流匹配）
CONFIG_FIRMWARE_ENABLE_IPV6=y
CONFIG_FIRMWARE_ENABLE_USB=y
CONFIG_FIRMWARE_ENABLE_SWAP=y
CONFIG_FIRMWARE_INCLUDE_CURL=y
CONFIG_FIRMWARE_INCLUDE_TCPDUMP=y
CONFIG_FIRMWARE_INCLUDE_OPENVPN=y
CONFIG_FIRMWARE_INCLUDE_TTYD=y
CONFIG_FIRMWARE_INCLUDE_FRPC=y
CONFIG_FIRMWARE_INCLUDE_FRPS=y
CONFIG_FIRMWARE_INCLUDE_WIREGUARD=y
CONFIG_FIRMWARE_INCLUDE_ZEROTIER=y
CONFIG_FIRMWARE_INCLUDE_VNTCLI=y
CONFIG_FIRMWARE_INCLUDE_VNTS=y
CONFIG_FIRMWARE_INCLUDE_N2N_V3=y
CONFIG_FIRMWARE_INCLUDE_N2N_V3_SUPERNODE=y
CONFIG_FIRMWARE_INCLUDE_ALIDDNS=y
CONFIG_FIRMWARE_INCLUDE_SMARTDNS=y

# 编译优化
CONFIG_FIRMWARE_COMPRESS_LZMA=y
CONFIG_FIRMWARE_STRIP_EXECUTABLES=y
CONFIG_FIRMWARE_SMALL_FLASH_OPTIMIZE=y

# 禁用冗余模块（精简固件）
CONFIG_FIRMWARE_INCLUDE_TRANSMISSION=n
CONFIG_FIRMWARE_INCLUDE_ARIA=n
CONFIG_FIRMWARE_INCLUDE_MINIDLNA=n
CONFIG_FIRMWARE_INCLUDE_SMBD=n
CONFIG_FIRMWARE_INCLUDE_FTPD=n
